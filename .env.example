# Turso (libSQL) — required for production / Vercel
# Create a database at https://turso.tech and copy values from the dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared site password — required to lock the app for invited visitors only.
# Set this in Vercel (and optionally in .env.local). Leave empty for open local demo.
SITE_PASSWORD=

# Without Turso vars, the app runs in demo mode with a local SQLite file:
# file:./data/local.db
